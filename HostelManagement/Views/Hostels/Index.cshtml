@model IEnumerable<HostelManagement.BusinessObject.Hostel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalRooms)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalRooms)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.HostelId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.HostelId">Details</a> |
                    <form asp-action="ToggleStatus" asp-route-id="@item.HostelId" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-link p-0 m-0 align-baseline"
                                style=" display:inline; color:#0d6efd; text-decoration:underline;"
                                onclick="return confirm('@(item.Status == "Active"
                                                   ? "Are you sure you want to deactivate this room?"
                                                   : "Are you sure you want to activate this room?")');">
                        @(item.Status == "Active" ? "Deactivate" : "Activate")
                    </button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>
