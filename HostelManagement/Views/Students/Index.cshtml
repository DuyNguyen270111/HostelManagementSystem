 @model IEnumerable<HostelManagement.BusinessObject.Student>

 @{ 
     ViewData["Title"] = "Danh sách sinh viên"; 
 } 

 <!-- Bootstrap CSS --> 
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"> 

 <style> 
     body { 
         font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
         background-color: #f8fafc; 
         margin: 20px; 
     } 

     h1 { 
         text-align: center; 
         color: #1e3a8a; 
         margin-bottom: 20px; 
     } 

     a { 
         color: #2563eb; 
         text-decoration: none; 
         transition: 0.2s; 
     } 

         a:hover { 
             color: #1e40af; 
             text-decoration: underline; 
         } 

     .btn-create { 
         display: inline-block; 
         background-color: #2563eb; 
         color: white; 
         padding: 8px 14px; 
         border-radius: 6px; 
         text-decoration: none; 
         transition: 0.2s; 
     } 

         .btn-create:hover { 
             background-color: #1d4ed8; 
         } 

     table { 
         width: 100%; 
         border-collapse: collapse; 
         background-color: white; 
         box-shadow: 0 4px 8px rgba(0,0,0,0.05); 
         border-radius: 8px; 
         overflow: hidden; 
     } 

     thead { 
         background-color: #1e3a8a; 
         color: white; 
     } 

     th, td { 
         padding: 12px 16px; 
         text-align: left; 
         border-bottom: 1px solid #e5e7eb; 
     } 

     tr:hover { 
         background-color: #f1f5f9; 
     } 

     td:last-child { 
         white-space: nowrap; 
     } 

     .actions a { 
         margin-right: 8px; 
         font-weight: 500; 
     } 

         .actions a:last-child { 
             margin-right: 0; 
         } 
 </style> 

 <h1>Danh sách sinh viên</h1> 

 <p>
    <button type="button" class="btn-create" id="btnAddStudent">
        + Thêm sinh viên mới
    </button>
 </p> 

 <table class="table"> 
     <thead> 
         <tr> 
             <th>@Html.DisplayNameFor(model => model.Name)</th> 
             <th>@Html.DisplayNameFor(model => model.Gender)</th> 
             <th>@Html.DisplayNameFor(model => model.Dob)</th> 
             <th>@Html.DisplayNameFor(model => model.Course)</th> 
             <th>@Html.DisplayNameFor(model => model.Phone)</th> 
             <th>@Html.DisplayNameFor(model => model.Email)</th> 
             <th>@Html.DisplayNameFor(model => model.Address)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
             <th>Thao tác</th> 
         </tr> 
     </thead> 
     <tbody> 
         @foreach (var item in Model) 
         { 
             <tr> 
                 <td>@Html.DisplayFor(modelItem => item.Name)</td> 
                 <td>@Html.DisplayFor(modelItem => item.Gender)</td> 
                 <td>@Html.DisplayFor(modelItem => item.Dob)</td> 
                 <td>@Html.DisplayFor(modelItem => item.Course)</td> 
                 <td>@Html.DisplayFor(modelItem => item.Phone)</td> 
                 <td>@Html.DisplayFor(modelItem => item.Email)</td> 
                 <td>@Html.DisplayFor(modelItem => item.Address)</td> 
                 <td>@Html.DisplayFor(modelItem => item.Status)</td> 
                 <td class="actions"> 
                    
                     <a href="javascript:void(0)" 
                        class="btn-details" 
                        data-id="@item.StudentId"> 
                         Chi tiết 
                     </a> |

                    <a href="javascript:void(0)"
                       class="btn-edit"
                       data-id="@item.StudentId">
                        Sửa
                    </a> |

                    <form asp-action="Lock" asp-route-id="@item.StudentId" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-link text-danger btn-delete p-0 m-0" style="text-decoration:none;">
                            @(item.Status == "Active" ? "Khóa tài khoản" : "Mở khóa")
                        </button>
                    </form>
                        
                   
                 </td> 
             </tr> 
         } 
     </tbody> 
 </table> 

 <!-- Modal hiển thị chi tiết sinh viên --> 
 <div class="modal fade" id="studentModal" tabindex="-1" aria-hidden="true"> 
     <div class="modal-dialog modal-dialog-centered modal-lg"> 
         <div class="modal-content"> 
             <div class="modal-header bg-primary text-white"> 
                 <h5 class="modal-title">Chi tiết sinh viên</h5> 
                 <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button> 
             </div> 
             <div class="modal-body" id="modalBody"> 
                 <p class="text-center text-muted">Đang tải...</p> 
             </div> 
         </div> 
     </div> 
 </div>
<!-- Modal thêm sinh viên -->
<div class="modal fade" id="createStudentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Thêm sinh viên mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="createModalBody">
                <p class="text-center text-muted">Đang tải form...</p>
            </div>
        </div>
    </div>
</div>
<!-- Modal chỉnh sửa sinh viên -->
<div class="modal fade" id="editStudentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title">Chỉnh sửa thông tin sinh viên</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="editModalBody">
                <p class="text-center text-muted">Đang tải form...</p>
            </div>
        </div>
    </div>
</div>
 <!-- JQuery + Bootstrap Bundle --> 
 <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> 
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> 

 <script>

    //nhấn nút chi tiết truyền ${id}
     $(document).on("click", ".btn-details", function () { 
         const id = $(this).data("id"); 

         $("#modalBody").html("<p class='text-center text-muted'>Đang tải...</p>"); 
         const myModal = new bootstrap.Modal(document.getElementById('studentModal')); 
         myModal.show(); 

         $.get(`/Students/Details/${id}`, function (data) { 
             $("#modalBody").html(data); 
         }).fail(function () { 
             $("#modalBody").html("<p class='text-danger text-center'>Không tải được dữ liệu.</p>"); 
         }); 
     }); 
 </script>
<script>
    // Khi nhấn nút "Thêm sinh viên mới"
    $("#btnAddStudent").on("click", function () {
        $("#createModalBody").html("<p class='text-center text-muted'>Đang tải form...</p>");

        const createModal = new bootstrap.Modal(document.getElementById('createStudentModal'));
        createModal.show();

        $.get("/Students/Create", function (data) {
            $("#createModalBody").html(data);
        }).fail(function () {
            $("#createModalBody").html("<p class='text-danger text-center'>Không tải được form.</p>");
        });
    });
</script>
<script>
    // Khi nhấn nút "Sửa"
    $(document).on("click", ".btn-edit", function () {
        const id = $(this).data("id");

        $("#editModalBody").html("<p class='text-center text-muted'>Đang tải form...</p>");

        const editModal = new bootstrap.Modal(document.getElementById('editStudentModal'));
        editModal.show();

        // Gọi GET /Students/Edit/{id} để load form
        $.get(`/Students/Edit/${id}`, function (data) {
            $("#editModalBody").html(data);
        }).fail(function () {
            $("#editModalBody").html("<p class='text-danger text-center'>Không tải được form chỉnh sửa.</p>");
        });
    });
</script>
 <script> 
     $(document).on("click", ".btn-delete", function (e) { 
         const isConfirmed = confirm("Bạn có chắc chắn muốn xóa sinh viên này không?"); 
         if (!isConfirmed) { 
             e.preventDefault(); // Ngăn không cho chuyển trang 
         } 
     }); 
 </script> 
